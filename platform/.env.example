# ==============================================================================
# Wacht Platform Environment Configuration
# ==============================================================================

# Server Port
CONSOLE_API_PORT=3001

# Database (PostgreSQL)
# Supports DATABASE_WRITER_URL, DATABASE_URL, or DATABASE_PRIMARY_PRIVATE
DATABASE_WRITER_URL=postgres://postgres:postgres@localhost:5432/wacht
# DATABASE_READER_URLS=

# Redis Cache
REDIS_URL=redis://127.0.0.1:6379

# NATS Messaging & JetStream
NATS_HOST=127.0.0.1:4222

# ClickHouse Analytics
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_PASSWORD=

# Object Storage (Cloudflare R2 / S3-compatible)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare DNS / Routing
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=

# System Email Delivery (Mailpit for local dev, or any SMTP provider)
# Default: Mailpit on localhost:1025 — works with mailpit.exe, no auth needed
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@yourdomain.com
# Gmail example (uncomment and fill to use Gmail instead of Mailpit):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-google-app-password
# SMTP_USE_TLS=true
# SMTP_FROM_EMAIL=your-email@gmail.com

# Data Encryption (Required: 32 bytes as 64 hex characters)
ENCRYPTION_KEY=8925b3cec2528f2355ab9f6aa2f263f2d1400909a160a41fa5aeb1109ac33323

# Optional: Embeddings (Gemini)
# GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2-preview

# Optional: Wacht Control Plane
# WACHT_API_URL=
# WACHT_SECRET_KEY=
